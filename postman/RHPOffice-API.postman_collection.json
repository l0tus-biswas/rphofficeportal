          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{baseUrl}}/admin/config/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "config", ":id"],
              "variable": [{"key": "id", "value": "config-id-here"}]
            }
          }
        },
        {
          "name": "Admin - Sync from .env File",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{baseUrl}}/admin/config/sync-from-env",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "config", "sync-from-env"]
            }
          }
        }
      ]
    }
  ]
