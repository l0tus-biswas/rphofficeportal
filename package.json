{
  "name": "rhp-office-portal",
  "version": "1.0.0",
  "description": "Escape Recruiting Platform - Full Stack Application",
  "scripts": {
    "start": "node index.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "install-all": "cd backend && npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build --configuration=production",
    "deploy": "npm run build && node index.js",
    "dev": "cd backend && npm run dev"
  },
  "keywords": [
    "recruiting",
    "onboarding",
    "document-management",
    "MERN"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
