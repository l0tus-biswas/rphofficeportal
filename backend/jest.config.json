{
  "testEnvironment": "node",
  "coverageDirectory": "./coverage",
  "collectCoverageFrom": [
    "**/*.js",
    "!**/node_modules/**",
    "!**/tests/**",
    "!**/coverage/**"
  ],
  "testMatch": [
    "**/tests/**/*.test.js"
  ],
  "testPathIgnorePatterns": [
    "/node_modules/"
  ],
  "setupFilesAfterEnv": ["./tests/setup.js"],
  "projects": [
    {
      "displayName": "unit",
      "testEnvironment": "node",
      "testMatch": [
        "**/tests/high-priority-fixes.test.js",
        "**/tests/medium-low-fixes.test.js",
        "**/tests/medium-low-batch2.test.js",
        "**/tests/medium-low-batch3.test.js",
        "**/tests/remaining-high-fixes.test.js"
      ],
      "setupFilesAfterEnv": ["./tests/setup.js"]
    },
    {
      "displayName": "integration",
      "testEnvironment": "node",
      "testMatch": [
        "**/tests/api.test.js",
        "**/tests/billing-payments.test.js",
        "**/tests/document-hub-onboarding.test.js",
        "**/tests/production-promotion-aca.test.js",
        "**/tests/coupon-free-access.test.js",
        "**/tests/security-fixes.test.js",
        "**/tests/models.test.js"
      ],
      "setupFilesAfterEnv": ["./tests/setup.js"]
    }
  ]
}
