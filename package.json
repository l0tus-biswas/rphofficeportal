{
  "name": "rhp-office-portal",
  "version": "1.0.0",
  "description": "Escape Recruiting Platform - Full Stack Application",
  "scripts": {
    "start": "cd backend && npm start",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build --configuration=production",
    "dev": "cd backend && npm run dev",
    "claude:preflight": "node scripts/claude-preflight.js",
    "claude:history:auto": "node scripts/auto-history.js",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:routes": "bash e2e/gen-routes.sh",
    "e2e:seed": "node e2e/seed.js"
  },
  "keywords": [
    "recruiting",
    "onboarding",
    "document-management",
    "MERN"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
