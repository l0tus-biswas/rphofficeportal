              "variable": [{"key": "stepKey", "value": "w4", "description": "One of: w4, driverLicense, ssn, directDeposit, voidCheck, i9"}]
            }
          }
        },
        {
          "name": "Admin - List All Onboardings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
