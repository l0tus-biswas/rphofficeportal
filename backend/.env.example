# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rhpoffice

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRE=30d

# Email Configuration (SMTP) - Legacy, kept for reference
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=admin@rhpoffice.com
SMTP_FROM_NAME=Escape

# Neuzmail Transactional Email API (https://neuzmail.in/api/v1, spec: /api/v1/openapi.json)
# Create an API key in Neuzmail → Settings → Developer (keys look like mfk_...).
# Required scopes: messages:send (+ verifications:write for verifyEmail)
NEUZMAIL_API_TOKEN=your-neuzmail-api-key
# Base URL only (defaults to https://neuzmail.in); the code appends /api/v1
NEUZMAIL_API_URL=https://neuzmail.in
# Template IDs (Neuzmail → Send → Templates). Emails are sent with template_id + params.
# Leave a value empty to fall back to the HTML rendered inside utils/neuzmail.js.
NEUZMAIL_TPL_WELCOME_PASSWORD=ff2bc34d-4d97-42c8-927a-88337f95955a
NEUZMAIL_TPL_WELCOME_SET_PASSWORD=e3abeb5d-6a8c-4ba2-b242-d2f340029292
NEUZMAIL_TPL_PASSWORD_RESET=48ea8ad7-d4c0-40a2-8981-1a7e12a6a89d
NEUZMAIL_TPL_APA_CONFIRM=82d66684-3483-46df-8342-5a5c12278805
NEUZMAIL_TPL_PAYMENT_LINK=09771464-b1af-493f-aedf-22ddb6afd996
NEUZMAIL_TPL_ACCOUNT_ACTIVATED=5457b761-1de6-4ea9-8eb1-40f4934b6a91
NEUZMAIL_TPL_NOTIFICATION=5fbfa504-672a-4040-90e6-fe23c841ff19

# Application
APP_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_ONE_TIME_PRICE=17900
STRIPE_MONTHLY_SUBSCRIPTION_PRICE=2000
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
APPLY_RATE_LIMIT_WINDOW_MS=3600000
APPLY_RATE_LIMIT_MAX=20
RESET_RATE_LIMIT_WINDOW_MS=3600000
RESET_RATE_LIMIT_MAX=3

# Zoho Sign Integration (replaced DocuSign — see backend/utils/zohosign.js)
# Setup (one-time):
#   1. Go to https://api-console.zoho.com and create a "Self Client".
#   2. Generate a grant token with scope ZohoSign.documents.ALL,ZohoSign.templates.ALL
#      and exchange it for a refresh token (see Zoho's Self Client docs — this
#      refresh token does not expire unless revoked).
#   3. Build the APA template in Zoho Sign (upload the PDF, add a signer role
#      named to match ZOHO_SIGN_ACTION_ROLE below, then position every field
#      from TEXT_FIELD_NAMES / CHECKBOX_FIELD_NAMES in backend/utils/zohosign.js
#      using those EXACT names as each field's "field_name").
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# Change these if your Zoho account is on a non-US data center (.eu, .in, .com.au, .jp)
ZOHO_SIGN_API_DOMAIN=https://sign.zoho.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_SIGN_TEMPLATE_ID=your-zoho-sign-template-id
ZOHO_SIGN_ACTION_ROLE=Agent
# Set after registering the webhook in Zoho Sign's dashboard (Settings > Webhooks),
# pointed at POST /api/public/apa-application/docusign-webhook (path kept from the
# DocuSign era — see comment in apa.routes.js). Signature verification is
# best-effort / unconfirmed — see the warning comment in zohosign.js.
ZOHO_SIGN_WEBHOOK_SECRET=your-webhook-hmac-secret

# --- DocuSign (legacy, kept only for rollback — backend/utils/docusign.js is
#     no longer called by any route) ---
# DOCUSIGN_INTEGRATION_KEY=your-integration-key-guid
# DOCUSIGN_SECRET_KEY=your-secret-key
# DOCUSIGN_ACCOUNT_ID=your-account-id-guid
# DOCUSIGN_USER_ID=your-user-id-guid
# DOCUSIGN_PRIVATE_KEY_PATH=./config/docusign_private.key
# DOCUSIGN_PRIVATE_KEY=base64-encoded-private-key
# DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# DOCUSIGN_TEMPLATE_ID=c1abdf9e-83be-49c5-9333-73788e5805e0
# DOCUSIGN_WEBHOOK_SECRET=your-webhook-hmac-secret

# ExamFX Integration (Licensing Progress Tracking)
# Get these from your ExamFX organization admin or API support
EXAMFX_API_URL=https://api.examfx.com/v1
EXAMFX_API_KEY=your-examfx-api-key
EXAMFX_API_SECRET=your-examfx-api-secret
EXAMFX_WEBHOOK_SECRET=your-examfx-webhook-secret
EXAMFX_ORG_ID=your-examfx-organization-id

# QuickBooks Online Integration (1099 contractor sync)
# Create an app at https://developer.intuit.com to get these
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
# 'sandbox' for development/testing, 'production' for real QuickBooks data
QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI configured on the Intuit app
QBO_REDIRECT_URI=http://localhost:5000/api/quickbooks/callback
