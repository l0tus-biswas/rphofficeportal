          "name": "Agent - Upload My Documents",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "w4",
                  "type": "file",
                  "src": [],
                  "description": "W4 Tax Form (PDF)"
                },
                {
                  "key": "driverLicense",
                  "type": "file",
                  "src": [],
                  "description": "Driver License (PDF)"
                },
                {
                  "key": "ssn",
                  "type": "file",
                  "src": [],
                  "description": "Social Security Card (PDF)"
                },
                {
                  "key": "directDeposit",
