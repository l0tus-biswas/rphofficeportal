            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configs\": [\n    {\n      \"_id\": \"config-id-1\",\n      \"value\": \"new-value-1\"\n    },\n    {\n      \"_id\": \"config-id-2\",\n      \"value\": \"new-value-2\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/config/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "config", "bulk"]
