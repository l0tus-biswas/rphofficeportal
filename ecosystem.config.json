{
  "apps": [{
    "name": "rhp-office-portal",
    "script": "backend/server.js",
    "instances": 1,
    "exec_mode": "fork",
    "watch": false,
    "max_memory_restart": "500M",
    "restart_delay": 3000,
    "max_restarts": 10,
    "env": {
      "NODE_ENV": "production",
      "PORT": 5000
    },
    "error_file": "./logs/err.log",
    "out_file": "./logs/out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "merge_logs": true
  }]
}
