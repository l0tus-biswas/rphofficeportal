{
  "name": "rhp-office-portal",
  "version": "1.0.0",
  "description": "Escape Recruiting Platform - Full Stack Application",
  "scripts": {
    "start": "cd backend && npm start",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm start",
    "install-all": "cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build --configuration=production",
    "dev": "cd backend && npm run dev",
    "claude:preflight": "node scripts/claude-preflight.js",
    "claude:history:auto": "node scripts/auto-history.js"
  },
  "keywords": [
    "recruiting",
    "onboarding",
    "document-management",
    "MERN"
  ],
  "author": "",
  "license": "ISC"
}
