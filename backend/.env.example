# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rhpoffice

# JWT Secret Keys
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this
JWT_REFRESH_EXPIRE=30d

# Email Configuration (SMTP) - Legacy, kept for reference
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@rhpoffice.com
SMTP_FROM_NAME=Escape

# Neuzmail Transactional Email API (new /api/v1/messages endpoint)
# Generate an API key in Neuzmail dashboard → Settings → API Keys
# Key scope must be "full_access" or "sending_only" for sending
NEUZMAIL_API_TOKEN=your-neuzmail-api-key
# Override the base URL (defaults to https://neuzmail.in)
NEUZMAIL_API_URL=https://neuzmail.in
# Template IDs — create templates in Neuzmail dashboard and paste the IDs here
# These are the saved template IDs (not UIDs), used with the templateId field
NEUZMAIL_TPL_WELCOME_PASSWORD=6a5370768e9cbda9dbdfc0da
NEUZMAIL_TPL_WELCOME_SET_PASSWORD=6a536f0d8e9cbda9dbdfc0d7
NEUZMAIL_TPL_PASSWORD_RESET=6a536e438e9cbda9dbdfc0d5
NEUZMAIL_TPL_APA_CONFIRM=6a536cdd8e9cbda9dbdfc0d3
NEUZMAIL_TPL_PAYMENT_LINK=6a536bb98e9cbda9dbdfc0d1
NEUZMAIL_TPL_ACCOUNT_ACTIVATED=6a5368f78e9cbda9dbdfc0cf
NEUZMAIL_TPL_NOTIFICATION=6a5366b78e9cbda9dbdfc0cd

# Application
APP_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_ONE_TIME_PRICE=17900
STRIPE_MONTHLY_SUBSCRIPTION_PRICE=2000
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
APPLY_RATE_LIMIT_WINDOW_MS=3600000
APPLY_RATE_LIMIT_MAX=20
RESET_RATE_LIMIT_WINDOW_MS=3600000
RESET_RATE_LIMIT_MAX=3

# DocuSign Integration
# Get these from https://admindemo.docusign.com (demo) or https://admin.docusign.com (production)
DOCUSIGN_INTEGRATION_KEY=your-integration-key-guid
DOCUSIGN_SECRET_KEY=your-secret-key
DOCUSIGN_ACCOUNT_ID=your-account-id-guid
DOCUSIGN_USER_ID=your-user-id-guid
DOCUSIGN_PRIVATE_KEY_PATH=./config/docusign_private.key
# Or use base64 encoded key directly:
# DOCUSIGN_PRIVATE_KEY=base64-encoded-private-key
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
# For production: https://www.docusign.net/restapi
# Use the new template ID: c1abdf9e-83be-49c5-9333-73788e5805e0 (RHP Office APA AGREEMENT 2026(1))
DOCUSIGN_TEMPLATE_ID=c1abdf9e-83be-49c5-9333-73788e5805e0
DOCUSIGN_WEBHOOK_SECRET=your-webhook-hmac-secret

# ExamFX Integration (Licensing Progress Tracking)
# Get these from your ExamFX organization admin or API support
EXAMFX_API_URL=https://api.examfx.com/v1
EXAMFX_API_KEY=your-examfx-api-key
EXAMFX_API_SECRET=your-examfx-api-secret
EXAMFX_WEBHOOK_SECRET=your-examfx-webhook-secret
EXAMFX_ORG_ID=your-examfx-organization-id

# QuickBooks Online Integration (1099 contractor sync)
# Create an app at https://developer.intuit.com to get these
QBO_CLIENT_ID=your-quickbooks-client-id
QBO_CLIENT_SECRET=your-quickbooks-client-secret
# 'sandbox' for development/testing, 'production' for real QuickBooks data
QBO_ENVIRONMENT=sandbox
# Must exactly match a Redirect URI configured on the Intuit app
QBO_REDIRECT_URI=http://localhost:5000/api/quickbooks/callback
