{
  "name": "rhpoffice-backend",
  "version": "1.0.0",
  "description": "MEAN Stack Recruiting Application Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "jest --selectProjects unit --coverage --forceExit --detectOpenHandles",
    "test:integration": "jest --selectProjects integration --coverage --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov --forceExit --detectOpenHandles",
    "recover:users": "node scripts/reconstruct-users.js",
    "backfill:document-request-files": "node scripts/backfill-document-request-files.js"
  },
  "keywords": [
    "recruiting",
    "mean-stack",
    "genealogy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stripe/stripe-js": "^8.6.0",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csv-parse": "^6.1.0",
    "docusign-esign": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "intuit-oauth": "^4.2.3",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-quickbooks": "^2.0.50",
    "nodemailer": "^6.9.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.0",
    "stripe": "^20.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
