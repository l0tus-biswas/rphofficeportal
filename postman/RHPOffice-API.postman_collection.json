    {
      "name": "System Configuration",
      "item": [
        {
          "name": "Admin - Get All Configurations",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {
              "raw": "{{baseUrl}}/admin/config?category=jwt",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "config"],
              "query": [
                {"key": "category", "value": "jwt", "disabled": true, "description": "Filter by category: database, server, email, jwt, application, other"}
              ]
            }
          }
        },
        {
          "name": "Admin - Create/Update Configuration",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"JWT_SECRET\",\n  \"value\": \"your-secret-key-here\",\n  \"category\": \"jwt\",\n  \"isSecret\": true,\n  \"isEditable\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "config"]
            }
          }
        },
